# Copy to .env and fill in real values before deploying

ENVIRONMENT=production
LOG_LEVEL=INFO

# Neon or other managed Postgres (keep ssl params in the URL)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Docker Compose overrides these to redis://redis:6379/...
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Comma-separated origins, or * for development only
CORS_ORIGINS=https://your-frontend.example.com

ACCESS_TOKEN_EXPIRE_MINUTES=30
SQL_ECHO=false
